# Local AI runtime. Do not expose OLLAMA_URL publicly in production.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen3-vl:4b
OLLAMA_VISION_MODEL=qwen3-vl:4b
# Unload after each response so Whisper can use the GPU for transcription.
OLLAMA_KEEP_ALIVE=0s
OLLAMA_TIMEOUT_MS=45000
MEDIA_COMMAND_TIMEOUT_MS=90000
AI_REVIEW_TIMEOUT_MS=180000

# Native media analysis binaries and multilingual Whisper model.
FFMPEG_BIN=ffmpeg
WHISPER_BIN=whisper-cli
WHISPER_MODEL_PATH=/absolute/path/to/ggml-base.bin

# Required for a production deployment. Use values provided by your MySQL host.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=chatspace
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=chatspace
JWT_SECRET=replace-with-a-long-random-secret
